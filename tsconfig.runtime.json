{
  // npm run typecheck, second pass: the runtime alone (no test file, no 'claude-code/testing'), so it never leans on a
  // declaration only a test brings in. isolatedDeclarations: every export's type is written where it is declared, so a
  // module's boundary reads without the checker. It needs `declaration`; noEmit (from the root) still writes nothing.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "isolatedDeclarations": true,
    "declaration": true,
    "paths": {
      "claude-code": ["./typings/claude-code/index.d.ts"]
    }
  },
  "include": [
    "plugin/sub-human/*.ts",
    "plugin/sub-human/core",
    "plugin/sub-human/store",
    "plugin/sub-human/module",
    "plugin/sub-human/commands",
    "plugin/sub-human/net",
    "typings/claude-code-tools",
    "typings/claude-code-mcp"
  ],
  "exclude": [
    "plugin/sub-human/**/*.node-test.ts",
    "plugin/sub-human/**/*.test.ts",
    "plugin/sub-human/test",
    "plugin/sub-human/vendor"
  ]
}
