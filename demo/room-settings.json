{
  "plansDirectory": "demo/.room/plans",
  "env": {
    "CLAUDE_CODE_MCP_TOOL_IDLE_TIMEOUT": "0"
  },
  "permissions": {
    "allow": [
      "mcp__room__await_human",
      "mcp__room__post",
      "mcp__room__read",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(node --test:*)",
      "Bash(npm test:*)",
      "Bash(npm --prefix demo/app test:*)",
      "Bash(demo/bin/room:*)",
      "Bash(node demo/bin/room:*)",
      "Edit(demo/app/**)",
      "Write(demo/app/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      { "matcher": "ExitPlanMode", "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/demo/hooks/gate-exitplan.js\"" }] },
      { "matcher": "Write|Edit|NotebookEdit|Bash", "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/demo/hooks/guard-room.js\"" }] },
      { "matcher": "SendMessage", "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/demo/hooks/guard-send.js\"" }] },
      { "matcher": "Agent|Task", "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/demo/hooks/guard-spawn.js\"" }] }
    ],
    "PostToolUse": [
      { "matcher": "Write|Edit", "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/demo/hooks/plan-publish.js\"" }] },
      { "matcher": "ExitPlanMode", "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/demo/hooks/decision-log.js\"" }] }
    ],
    "SubagentStart": [
      { "matcher": "seat-.*", "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/demo/hooks/seat-register.js\"" }] }
    ],
    "SubagentStop": [
      { "matcher": "seat-.*", "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/demo/hooks/seat-park.js\"" }] }
    ],
    "SessionStart": [
      { "matcher": "compact", "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/demo/hooks/session-digest.js\"" }] }
    ],
    "PreCompact": [
      { "matcher": "auto|manual", "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/demo/hooks/precompact-note.js\"" }] }
    ]
  }
}
