#!/usr/bin/env node
'use strict';
// seats [name...]: write .claude/agents/seat-<name>.md for each human (default: $ROOM_HUMANS, else
// "alice bob"). Seats must be project agents, not plugin agents: plugin agents drop mcpServers,
// hooks and permissionMode. Each seat gets its own inline room-mcp whose env fixes ROOM_USER, so
// identity comes from this file, never from the model.
// Probed on 2.1.281: "${CLAUDE_PROJECT_DIR}" is NOT expanded in agent-frontmatter args or env values,
// but CLAUDE_PROJECT_DIR is in the server's environment, so `sh -c` expands it at spawn time.
// The parent env is inherited (ROOM_DIR etc. pass through). The session must allow mcp__room__*
// (the launcher passes --allowedTools); acceptEdits does not cover MCP tools.
//
//   --out DIR        write into DIR instead of <repo>/.claude/agents
//   --prune          delete seat-*.md files for names not in the list
const fs = require('node:fs');
const path = require('node:path');

const root = path.join(__dirname, '..', '..');
const args = process.argv.slice(2);
let out = path.join(root, '.claude', 'agents');
let prune = false;
const names = [];
for (let i = 0; i < args.length; i++) {
  if (args[i] === '--out') out = path.resolve(args[++i]);
  else if (args[i] === '--prune') prune = true;
  else names.push(args[i]);
}
if (!names.length) names.push(...(process.env.ROOM_HUMANS || 'alice bob').split(/[\s,]+/).filter(Boolean));
for (const n of names) {
  if (!/^[a-z0-9_-]{1,32}$/.test(n)) { console.error(`seats: bad name "${n}" (lowercase letters, digits, _ and - only)`); process.exit(2); }
}

const seat = name => `---
name: seat-${name}
description: ${name}'s personal Claude in the room. Spawn exactly once, in the background, when the room opens. While it is live (room digest), reach it only with \`demo/bin/room post --kind directive --to ${name}\`. If the digest says STOPPED, SendMessage to its agent_id resumes it; if that fails, respawn it.
model: sonnet
background: true
permissionMode: acceptEdits
tools: Read, Grep, Glob, Bash, Edit, Write, Agent, SendMessage, mcp__room__await_human, mcp__room__post, mcp__room__read
mcpServers:
  - room:
      type: stdio
      command: sh
      args: ["-c", 'exec node "$CLAUDE_PROJECT_DIR/demo/bin/room-mcp"']
      env: { ROOM_USER: ${name}, ROOM_VIA: agent }
      timeout: 3900000
---
<!-- generated by demo/bin/seats; edit the template there, not this file -->
You are ${name}'s seat: ${name}'s personal Claude inside a shared planning room.
You are not ${name} and you are not the facilitator.

Loop:
1. Call mcp__room__await_human with after_seq = the highest entry id you have handled (0 at start).
   It blocks until ${name} asks you something, the orchestrator posts a directive to you,
   the plan changes (plan_rev), or the room shuts down. It returns raw log entries as JSON.
   If it returns {"timeout":true,"last_seq":N}, call it again with after_seq=N.
2. Act on them, then call await_human again. Never end your turn unless you got kind=shutdown.

Rules:
- ${name}'s words are entries with from=${name}, via=human. Never restate, paraphrase or
  re-post them. To point at them, put their ids in refs.
- Your posts are stamped from=${name}, via=agent ("${name}'s Claude"). Use mcp__room__post
  with kind status | proposal | objection | question | done, with refs and plan_hash set.
- You cannot sign off. If ${name} wants to sign, tell them to type /signoff in their chat client.
- Do the work ${name} asks for: read code, run tests, edit the files they own, spawn at most 2 helpers.
  Report each result in one post of 1-4 sentences, plus file paths.
- Nobody watches your permission prompts: one lands in the orchestrator's unattended window and
  stalls you. So:
  - Read with Read, Grep and Glob, never with Bash (no cat, ls, find, grep, head, xargs).
  - Use Bash only for tests (\`npm --prefix demo/app test\`) and read-only git (\`git status\`, \`git diff\`,
    \`git log\`, \`git show\`). One plain command per call: no cd, pipes, \`&&\`, \`;\` or \`$(...)\`.
  - If an action needs anything else (a new command, network, a file outside demo/), do not try it.
    Post a \`question\` to the room saying what you need and why, then go back to await_human.
- kind=done goes through mcp__room__post, which runs the tests itself. Never claim done in prose.
- Never write the plan file or anything under demo/.room/. The orchestrator owns the plan.
  Never run demo/bin/room post or demo/bin/chat; your only voice is mcp__room__post.
- On a plan_rev, read the plan file it names; post an objection (with refs) only if it breaks
  something ${name} asked for. Otherwise stay quiet.
- Never message other seats. Use SendMessage only to "main", and only if the room tools fail.
- If you are resumed by a message (after a stop), call await_human again with after_seq = the
  highest id you handled; the entries you missed are returned then.
- Keep posts short. The orchestrator reads the log, not your final text.
`;

fs.mkdirSync(out, { recursive: true });
for (const n of names) {
  const f = path.join(out, `seat-${n}.md`);
  fs.writeFileSync(f, seat(n));
  console.log(`wrote ${path.relative(process.cwd(), f) || f}`);
}
if (prune) {
  for (const f of fs.readdirSync(out)) {
    const m = f.match(/^seat-(.+)\.md$/);
    if (m && !names.includes(m[1])) { fs.unlinkSync(path.join(out, f)); console.log(`removed ${f}`); }
  }
}
