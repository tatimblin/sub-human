#!/usr/bin/env node
// showcase: a paced, on-screen walkthrough of the two halves working together:
// bob's GET /tasks route serving live requests, then alice's contract tests run against it.
// SHOWCASE_FAST=1 skips the pauses.

const path = require('node:path');
const { spawn } = require('node:child_process');

const APP = path.join(__dirname, '..', 'app');
const fast = !!process.env.SHOWCASE_FAST;
const pause = ms => new Promise(r => setTimeout(r, fast ? 0 : ms));
const c = { b: '\x1b[1m', d: '\x1b[2m', r: '\x1b[0m', cyan: '\x1b[36m', yel: '\x1b[33m', grn: '\x1b[32m', red: '\x1b[31m', mag: '\x1b[35m' };

const heading = async (who, color, title) => {
  console.log(`\n${color}${c.b}━━ ${who}${c.r}${c.b}  ${title}${c.r}`);
  await pause(900);
};
const step = async text => {
  console.log(`\n${c.d}›${c.r} ${text}`);
  await pause(700);
};
const req = async (base, method, url, body) => {
  console.log(`  ${c.b}${method}${c.r} ${url}`);
  const res = await fetch(base + url, { method, body: body && JSON.stringify(body) });
  const json = await res.json();
  const sc = res.status < 400 ? c.grn : c.red;
  console.log(`  ${sc}${res.status}${c.r}`);
  await pause(400);
  return json;
};
const row = t => `    #${String(t.id).padStart(3)}  ${t.createdAt}  ${t.title}`;

(async () => {
  const { start } = await import(path.join(APP, 'src/server.js'));
  const { reset, seed } = await import(path.join(APP, 'src/store.js'));
  reset();
  seed(237);
  const server = start(0);
  const base = `http://localhost:${server.address().port}`;

  console.log(`${c.b}GET /tasks${c.r}: keyset pagination, newest first`);
  console.log(`${c.d}Agreed by alice + bob in the room. bob built the route; alice's tests hold it to the contract.${c.r}`);

  await heading('bob', c.yel, "the route, serving live requests");
  await step('First page. Newest first; total_count for "Page 1 of N"');
  const p1 = await req(base, 'GET', '/tasks?limit=5');
  p1.tasks.forEach(t => console.log(row(t)));
  console.log(`    ${c.d}next_cursor${c.r} ${p1.next_cursor.slice(0, 32)}…   ${c.d}total_count${c.r} ${p1.total_count}`);
  await pause(1200);

  await step('Three new tasks arrive while the user is reading page 1 (30 inserts/sec in prod)');
  for (const title of ['Ship pagination', 'Tell design about load-more', 'Celebrate']) {
    const t = await req(base, 'POST', '/tasks', { title });
    console.log(row(t));
  }
  await pause(800);

  await step('Page 2 with the cursor. With offset, the last 3 tasks of page 1 would show up again');
  const p2 = await req(base, 'GET', `/tasks?limit=5&cursor=${p1.next_cursor}`);
  p2.tasks.forEach(t => console.log(row(t)));
  const seen = new Set(p1.tasks.map(t => t.id));
  const dupes = p2.tasks.filter(t => seen.has(t.id));
  console.log(`    ${dupes.length ? c.red + '✖ ' + dupes.length + ' duplicates' : c.grn + '✔ no duplicates, picks up exactly where page 1 ended'}${c.r}`);
  await pause(1200);

  await step('Walk every page at limit=20');
  const ids = [];
  let cursor = null, pages = 0;
  do {
    const p = await (await fetch(`${base}/tasks?limit=20${cursor ? '&cursor=' + cursor : ''}`)).json();
    ids.push(...p.tasks.map(t => t.id));
    cursor = p.next_cursor;
    pages++;
    process.stdout.write(`\r    page ${String(pages).padStart(2)}  ${String(ids.length).padStart(3)} tasks`);
    await pause(60);
  } while (cursor);
  const unique = new Set(ids).size;
  console.log(`\n    ${unique === ids.length && unique === 240 ? c.grn + '✔' : c.red + '✖'} ${ids.length} tasks over ${pages} pages, ${unique} unique, next_cursor null on the last page${c.r}`);
  await pause(1000);

  await step('A tampered cursor is rejected, not silently misread');
  console.log('    ' + JSON.stringify(await req(base, 'GET', '/tasks?cursor=not-a-real-cursor')));

  server.close();
  await pause(800);

  await heading('alice', c.cyan, "the contract tests, run against bob's route");
  const t = spawn(process.execPath, ['--test', '--test-reporter=spec'], { cwd: APP, env: { ...process.env, FORCE_COLOR: '1' } });
  let failed = false;
  for await (const chunk of t.stdout) {
    for (const line of chunk.toString().split('\n')) {
      if (!line.trim() || /duration_ms|ℹ (suites|cancelled|skipped|todo)/.test(line)) continue;
      if (/✖/.test(line)) failed = true;
      console.log('  ' + line.replace(/\s*\(\d+(\.\d+)?ms\)/, ''));
      await pause(70);
    }
  }
  const code = await new Promise(r => t.on('close', r));
  await pause(600);
  console.log(`\n${code === 0 && !failed ? c.grn + c.b + '✔ Two engineers, one contract, built in parallel: it fits.' : c.red + c.b + '✖ Something is off. See the failures above.'}${c.r}\n`);
  process.exit(code);
})();
