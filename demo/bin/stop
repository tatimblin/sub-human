#!/bin/zsh
# stop: end every demo session (v1 demo-* and v2 room-*) and everything they left behind: the
# orchestrator / v1 claude processes, room-mcp servers, Monitor tails, chat and watch clients, and
# any server an agent started on port 3000. Prints whatever is still running at the end.
root=${0:A:h:h:h}
for s in $(tmux list-sessions -F '#{session_name}' 2>/dev/null | grep -E '^(demo|room)-'); do
  tmux kill-session -t "$s" 2>/dev/null
done

# Process patterns, as launched by demo/bin/start (cwd = repo root) or by an absolute path.
pats=(
  'claude -n room-orch '                                          # v2 orchestrator (seats live inside it)
  'claude -n (facilitator|alice|bob) --permission-mode auto'      # v1 persona seats
  'demo/bin/room-mcp'                                             # seat MCP servers (orphans)
  'demo/bin/room (tail|watch|wait)'                               # Monitor tails, watch feed
  'node ([^ ]*/)?demo/bin/chat'                                   # chat clients
)
running() { for p in $pats; do pgrep -f -- "$p"; done 2>/dev/null | sort -u | grep -vx $$; }
pids=($(running))
if (( ${#pids} )); then
  kill $pids 2>/dev/null
  for i in {1..10}; do pids=($(running)); (( ${#pids} )) || break; sleep 0.3; done
  (( ${#pids} )) && kill -9 $pids 2>/dev/null
fi

pids=$(lsof -ti tcp:3000 -sTCP:LISTEN 2>/dev/null)
if [[ -n $pids ]]; then
  kill ${=pids} 2>/dev/null; sleep 1
  pids=$(lsof -ti tcp:3000 -sTCP:LISTEN 2>/dev/null)
  [[ -n $pids ]] && kill -9 ${=pids} 2>/dev/null
  echo "stopped server on :3000"
fi

left=($(running))
sessions=$(tmux list-sessions -F '#{session_name}' 2>/dev/null | grep -E '^(demo|room)-')
if (( ${#left} )) || [[ -n $sessions ]] || lsof -ti tcp:3000 -sTCP:LISTEN >/dev/null 2>&1; then
  print -u2 "stop: still running:"
  [[ -n $sessions ]] && print -u2 "  tmux: ${sessions//$'\n'/ }"
  for p in $left; do print -u2 "  $(ps -o pid=,command= -p $p | cut -c1-120)"; done
  lsof -ti tcp:3000 -sTCP:LISTEN >/dev/null 2>&1 && print -u2 "  port 3000"
  exit 1
fi
echo "demo stopped"
