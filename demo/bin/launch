#!/bin/zsh
# launch [--humans "alice bob"]: v2 room. Reset, generate the seat agents, start the orchestrator
# (Claude, unattended: an ops console nobody types into), one chat client per human (the host is
# just one of them) and a watch feed, each in its own tmux session with a Ghostty window attached.
# tmux lets an operator read screens (capture-pane) and answer the first-run trust prompt (send-keys).
#
# launch --v1 [--human ROLE]...: the original persona demo (facilitator/alice/bob as model seats).
root=${0:A:h:h:h}
ghostty() { # ghostty <session> <title> <x> <y>
  open -na Ghostty.app --args \
    --title="$2" --quit-after-last-window-closed=true \
    --window-position-x=$3 --window-position-y=$4 \
    --window-width=118 --window-height=30 \
    -e /opt/homebrew/bin/tmux attach -t "$1"
}
accept_trust() { # answer the first-run folder prompt with its default, for the given sessions
  for i in {1..20}; do
    local pending=0
    for s in "$@"; do
      if tmux capture-pane -p -t "$s" 2>/dev/null | grep -q "Enter to confirm"; then
        tmux send-keys -t "$s" Enter; pending=1
      fi
    done
    (( i > 5 && ! pending )) && break
    sleep 1
  done
}

if [[ $1 == --v1 ]]; then
  shift
  humans=()
  while [[ $1 == --human ]]; do humans+=$2; shift 2; done
  "$root/demo/bin/reset"
  typeset -A x=(facilitator 0 watch 960 alice 0 bob 960)
  typeset -A y=(facilitator 30 watch 30 alice 560 bob 560)
  for role in watch facilitator alice bob; do
    tmux kill-session -t "demo-$role" 2>/dev/null
    tmux new-session -d -s "demo-$role" -x 118 -y 30 -e "DEMO_V1=1" -e "DEMO_HUMANS=${humans[*]}" "$root/demo/bin/start $role"
    ghostty "demo-$role" $role ${x[$role]} ${y[$role]}
  done
  accept_trust demo-facilitator demo-alice demo-bob
  echo "launched v1${humans:+ (human: ${humans[*]})}"
  exit 0
fi

humans_str=${ROOM_HUMANS:-"alice bob"}
while (( $# )); do
  case $1 in
    --humans) humans_str=$2; shift 2 ;;
    *) print -u2 "usage: launch [--humans \"alice bob\"] | launch --v1 [--human ROLE]..."; exit 2 ;;
  esac
done
humans=(${=${humans_str//,/ }})
(( ${#humans} )) || { print -u2 "launch: no humans"; exit 2; }

[[ -f $root/demo/room-settings.json ]] || print -u2 "launch: warning: demo/room-settings.json not found; the orchestrator runs without room hooks"
"$root/demo/bin/stop" >/dev/null
"$root/demo/bin/reset"
mkdir -p "$root/demo/.room/plans"
"$root/demo/bin/seats" --prune $humans || exit 1

envs=(-e "ROOM_HUMANS=${humans[*]}")
start_role() { # start_role <role> <x> <y>
  tmux new-session -d -s "room-$1" -x 118 -y 30 $envs "$root/demo/bin/start $1"
  ghostty "room-$1" $1 $2 $3
}
start_role watch 960 30
start_role orch 0 30
i=0
for h in $humans; do
  start_role $h $(( (i % 2) * 960 )) $(( 560 + (i / 2) * 60 ))
  (( i++ ))
done
accept_trust room-orch
echo "launched room (humans: ${humans[*]}); everyone, the host included, types in their chat window"
