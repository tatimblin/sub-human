{
  "name": "sub-human-repo",
  "private": true,
  "description": "Dev scripts for the sub-human Claude Code plugin (no dependencies).",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "npm run --silent test:plugin && npm run --silent test:scripts && npm run --silent test:mods",
    "test:plugin": "node --test plugin/sub-human/test",
    "test:scripts": "node --test --require ./plugin/sub-human/test/helpers.js scripts/test",
    "test:mods": "node scripts/test-mods.js",
    "test:thread-store": "SUB_HUMAN_TEST_THREAD_STORE=1 NODE_OPTIONS=\"--require $PWD/plugin/sub-human/test/support/thread-store.js\" node --test plugin/sub-human/test/hooks",
    "validate": "claude plugin validate plugin/sub-human --strict",
    "probe": "node scripts/probe-cc.js",
    "docs": "node scripts/arch-doc.js",
    "test:remote-docker": "node --test scripts/remote-docker/remote-docker.test.js"
  }
}
