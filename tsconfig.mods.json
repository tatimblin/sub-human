{
  // npm run typecheck, third pass: the hooks module's wiring tests (plugin/sub-human/mod/test/*.test.ts, run by
  // `claude plugin test` in Claude Code's own environment). 'claude-code/testing' is declared in the same snapshot as
  // 'claude-code' (typings/claude-code/index.d.ts).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "claude-code": ["./typings/claude-code/index.d.ts"],
      "claude-code/testing": ["./typings/claude-code/index.d.ts"]
    }
  },
  "include": [
    "plugin/sub-human/mod/test",
    "plugin/sub-human/types",
    "typings/claude-code-tools"
  ],
  "exclude": []
}
