{
  // npm run typecheck (docs/archive/TYPESCRIPT.md, decision 8). Nothing is emitted: node strips the types of each .ts it
  // loads (Node 24.3+) and Claude Code transpiles the hooks module (mod/); only this checks them.
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "noEmit": true,
    "target": "es2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"],
    // import type { ... } from 'claude-code': the committed snapshot of the declarations Claude Code writes beside a
    // hooks module (.claude-plugin/types/, gitignored); refresh it from there after a Claude Code update
    "paths": {
      "claude-code": ["./typings/claude-code/index.d.ts"]
    }
  },
  "include": [
    "plugin/sub-human/lib",
    "plugin/sub-human/hooks",
    "plugin/sub-human/mcp",
    "plugin/sub-human/statusline",
    "plugin/sub-human/mod",
    "plugin/sub-human/types",
    "typings/claude-code-tools"
  ],
  "exclude": [
    "plugin/sub-human/mod/test",
    "plugin/sub-human/test"
  ]
}
