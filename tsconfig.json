{
  // npm run typecheck. Nothing is emitted: node strips the types of each .ts it loads (Node 22.18+) and Claude Code
  // transpiles the hooks module (module/); only this checks them. This is the whole plugin: the runtime and its tests
  // (*.node-test.ts for node, *.test.ts for Claude Code's test kit), as one project, which is what an editor and the
  // type-aware linter (npm run lint) read. tsconfig.runtime.json checks the runtime again on its own, so it never leans
  // on a test's declarations; the repo scripts are their own project, scripts/tsconfig.json.
  "compilerOptions": {
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "noEmit": true,
    "target": "es2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"],
    // import type { ... } from 'claude-code': the committed snapshot of the declarations Claude Code writes beside a
    // hooks module (.claude-plugin/types/, gitignored); refresh it with npm run typings after a Claude Code update.
    // The same file declares 'claude-code/testing', the kit the *.test.ts files import under `claude plugin test`.
    "paths": {
      "claude-code": ["./typings/claude-code/index.d.ts"],
      "claude-code/testing": ["./typings/claude-code/index.d.ts"]
    }
  },
  "include": [
    "plugin/sub-human",
    "typings/claude-code-tools",
    "typings/claude-code-mcp"
  ],
  "exclude": [
    "plugin/sub-human/vendor",
    "plugin/sub-human/test/fixtures",
    "plugin/sub-human/.claude-plugin"
  ]
}
