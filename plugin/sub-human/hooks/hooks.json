{
  "hooks": {
    "UserPromptExpansion": [
      {
        "matcher": "^(sub-human:)?sub-human$",
        "hooks": [
          {
            "type": "command",
            "command": "v=$(node -v 2>/dev/null); case \"$v\" in v24.[3-9]*|v24.[1-9][0-9]*|v2[5-9].*|v[3-9][0-9].*|v[1-9][0-9][0-9]*) ;; *) echo \"sub-human needs Node 24.3 or newer on the PATH that Claude Code was started with, and found $([ -n \"$v\" ] && echo \"node $v\" || echo 'none (node: command not found)'). Install it (https://nodejs.org, or nvm, fnm or mise) and restart claude from a shell where node -v works.\" >&2; exit 2;; esac; exec node --import \"${CLAUDE_PLUGIN_ROOT}/hooks/compile-cache.js\" \"${CLAUDE_PLUGIN_ROOT}/hooks/run.ts\" join",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node --import \"${CLAUDE_PLUGIN_ROOT}/hooks/compile-cache.js\" \"${CLAUDE_PLUGIN_ROOT}/hooks/run.ts\" row-guard",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(AskUserQuestion|EnterPlanMode|ExitPlanMode)$|^mcp__plugin_sub-human_room__",
        "hooks": [
          {
            "type": "command",
            "command": "node --import \"${CLAUDE_PLUGIN_ROOT}/hooks/compile-cache.js\" \"${CLAUDE_PLUGIN_ROOT}/hooks/run.ts\" consent",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node --import \"${CLAUDE_PLUGIN_ROOT}/hooks/compile-cache.js\" \"${CLAUDE_PLUGIN_ROOT}/hooks/run.ts\" row-map",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "AskUserQuestion|EnterPlanMode|ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "node --import \"${CLAUDE_PLUGIN_ROOT}/hooks/compile-cache.js\" \"${CLAUDE_PLUGIN_ROOT}/hooks/run.ts\" consent",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "node --import \"${CLAUDE_PLUGIN_ROOT}/hooks/compile-cache.js\" \"${CLAUDE_PLUGIN_ROOT}/hooks/run.ts\" consent",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --import \"${CLAUDE_PLUGIN_ROOT}/hooks/compile-cache.js\" \"${CLAUDE_PLUGIN_ROOT}/hooks/run.ts\" row-hold",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|fork",
        "hooks": [
          {
            "type": "command",
            "command": "node --import \"${CLAUDE_PLUGIN_ROOT}/hooks/compile-cache.js\" \"${CLAUDE_PLUGIN_ROOT}/hooks/run.ts\" row-launcher",
            "async": true,
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "compact|clear|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node --import \"${CLAUDE_PLUGIN_ROOT}/hooks/compile-cache.js\" \"${CLAUDE_PLUGIN_ROOT}/hooks/run.ts\" session-restore",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "node --import \"${CLAUDE_PLUGIN_ROOT}/hooks/compile-cache.js\" \"${CLAUDE_PLUGIN_ROOT}/hooks/run.ts\" row-rewake",
            "asyncRewake": true,
            "rewakeSummary": "sub-human: restoring rows",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --import \"${CLAUDE_PLUGIN_ROOT}/hooks/compile-cache.js\" \"${CLAUDE_PLUGIN_ROOT}/hooks/run.ts\" session-end",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "idle_prompt|permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "node --import \"${CLAUDE_PLUGIN_ROOT}/hooks/compile-cache.js\" \"${CLAUDE_PLUGIN_ROOT}/hooks/run.ts\" presence",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --import \"${CLAUDE_PLUGIN_ROOT}/hooks/compile-cache.js\" \"${CLAUDE_PLUGIN_ROOT}/hooks/run.ts\" presence",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ]
  },
  "modules": [
    "../mod/register.ts"
  ]
}
