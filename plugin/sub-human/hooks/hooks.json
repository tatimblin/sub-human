{
  "modules": ["../module/register.ts"],
  "hooks": {
    "UserPromptExpansion": [
      {
        "matcher": "^(sub-human:)?sub-human$",
        "hooks": [{ "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/node.sh\" expand", "timeout": 15 }]
      }
    ],
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/node.sh\" start", "timeout": 5 }] }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [{ "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/node.sh\" notify", "timeout": 5 }]
      }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/node.sh\" end", "timeout": 5 }] }
    ]
  }
}
