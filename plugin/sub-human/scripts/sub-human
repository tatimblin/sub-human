#!/usr/bin/env node
'use strict';
/**
 * plugin/sub-human/scripts/sub-human: the read-only CLI over the room. There is no post command: writes come only
 * from the plugin's hooks and the MCP server. Without --room / CODE, the room is this session's
 * (identity.resolveSelf(): the session id env, then the nearest registered ancestor claude pid).
 *
 *   sub-human tail [--ndjson] [--max-seconds S]
 *       The hooks module's child (mod/deliver.mjs starts it with $.process.spawn, CLAUDE_CODE_SESSION_ID set to the
 *       session's id; --ndjson is accepted for that argv and is the only output). Silent until this session has a
 *       seat: while it has none it looks the seat up by CLAUDE_CODE_SESSION_ID / CLAUDE_PID every
 *       SUB_HUMAN_UNSEATED_MS (10000; a `ps` ancestor walk only when neither is set). Once seated it re-resolves
 *       every SUB_HUMAN_RESOLVE_MS (2000), follows that room from the cursor deliver-<name> (without re-reading
 *       the log from byte 0) and writes one JSON event per line for the mod to route (seat, chat, pull, wake,
 *       rows, health; lib/tail.js documents them), switching (or going silent) if the seat changes.
 *       Settle: entries are batched and written as ONE set of events (at most one wake) after
 *       SUB_HUMAN_SETTLE_MS (1500) of quiet or SUB_HUMAN_SETTLE_MAX_MS (5000) at most (the orch: 3000 / 10000,
 *       SUB_HUMAN_ORCH_SETTLE_MS / SUB_HUMAN_ORCH_SETTLE_MAX_MS). Each entry is judged again against the log at
 *       send time (answered / decided entries are dropped). A member_left X is held
 *       SUB_HUMAN_LEAVE_MS (8000): if X rejoins in that time both notices are dropped.
 *       A member's chat is a group chat (room.chatLines, no ids): "bob: <exact words>", "bob's Claude: …",
 *       "bob joined", "bob left". Lines meant only for Claude start with "(for Claude)". The orch's wake opens
 *       with room.stateLine() ("room now: …"), then one room.line(e, {full}) per entry (ids kept: its tools take
 *       them), a leave marked "· away 8s+"; its member_joined is pushed when lib/rows.js joinNote() says that
 *       member's row is not running (the line ends with the note and the Agent call).
 *       It never exits on an error: it logs to stderr (rate-limited), backs off and carries on. Every
 *       SUB_HUMAN_TAIL_HEALTH_MS (5000) it checks the log's hash chain and, as the orch, runs orch.watchdog(code).
 *       It exits on --max-seconds, SIGTERM / SIGINT / SIGHUP, when its parent goes (the ppid changes) or when
 *       stdout closes.
 *   sub-human read [N[,M] | --id N[,M]] [--json] [--room CODE]
 *       entries in full: by id, or this session's unseen entries (cursor read-<name>)
 *   sub-human digest [--room CODE]     the compaction digest (<= 9,500 chars)
 *   sub-human who                      this session's identity: "<name> (<role>) in <code>"
 *   sub-human tasks [--json] [--room CODE]
 *       the room's shared task list (lib/tasks.js list(code), the orch's native list mirrored to
 *       the room document `tasks`): "#2 in_progress  bob  parser tests". --json prints the array.
 *   sub-human watch NAME [--room CODE] [--follow|--no-follow]
 *       NAME's thread: their own words, their Claude's posts (labelled "NAME's Claude"), their answers,
 *       their joins/leaves, and entries addressed to them. The orchestrator's posts are labelled
 *       "facilitator". Follows live when stdout is a terminal (or with --follow).
 *   sub-human agent-statusline
 *       Claude Code's subagentStatusLine command (statusline/*). Never fails: on any error it prints
 *       nothing and exits 0.
 *   sub-human serve --stdio CODE [--link ID]
 *       One remote connection to room CODE hosted here (lib/remote/server.js): protocol frames on stdin and
 *       stdout (lib/remote/transports/pipe.js), errors on stderr; exits when stdin ends. A remote machine's
 *       link spawns it (a pipe), or sshd runs it as the forced command `authorize` wrote. Without a link token
 *       or an invite it answers hello and nothing else. --link ID: only that link's token (or the invite
 *       reserved for it) is accepted; any other is AUTH.
 *   sub-human link CODE [--reset]
 *       The link daemon of room CODE, hosted on another machine (lib/remote/link.js run): the join hook starts it
 *       detached; it exits on its own once this machine has no seat left in the room. --reset (with no daemon
 *       running, e.g. after a FORK): forget this machine's copy of the room and start the daemon to copy it again.
 *   sub-human invite [--room CODE] [--ssh USER@HOST[:PORT]] [--via JUMP]
 *       An sh1 invite (no PIN) to a room hosted here (lib/remote/auth.js mintInvite), for one machine.
 *       --ssh: the other machine reaches this one as USER@HOST[:PORT] over SSH (lib/remote/link.js sshLocator), --via
 *       through that ProxyJump; without it the invite is for a second home on this machine (pipe). Then run
 *       authorize with their key. `host` below is the one-step sh2 way.
 *   sub-human host [--room CODE] [--ssh [USER@HOST[:PORT]]] [--via JUMP]     (lib/cli/host.js)
 *       An sh2 invite and its PIN, as /sub-human host shows them (lib/remote/hosting.js hostInvite). --ssh alone:
 *       this machine's own address (SUB_HUMAN_SSH_ADDR, else user@hostname); the invite pins this machine's sshd
 *       Ed25519 host key. The joiner's join then shows them an admit request to send back.
 *   sub-human admit REQUEST [--file AUTHORIZED_KEYS] [--yes]                 (lib/cli/host.js)
 *       Let in the key an admit request (shk1.…) carries, for the invite it names: one forced-command line in
 *       authorized_keys (default SUB_HUMAN_AUTHORIZED_KEYS, else ~/.ssh/authorized_keys), for that room's link only.
 *       Asks y/N on a terminal; /sub-human admit REQUEST in the host's session does the same.
 *   sub-human revoke LINK_ID|NAME [--room CODE] [--file AUTHORIZED_KEYS]      (lib/cli/revoke.js)
 *       End a link: token burnt, its authorized_keys lines removed, its seats leave, a room line says so.
 *   sub-human prime CODE [--persist 8h]                                      (lib/cli/host.js)
 *       On the joining machine: open a shared ssh connection (ControlMaster) for room CODE's link, interactively,
 *       so an MFA bastion or host asks once; the link daemon then rides it.
 *   sub-human authorize INVITE|LINK_ID PUBKEY_FILE|- [--room CODE] [--file AUTHORIZED_KEYS]
 *       The authorized_keys line that lets the holder of that SSH public key reach room CODE (the invite's, or
 *       --room with a link id) as that one link and nothing else:
 *         command="SUB_HUMAN_HOME=<home> <home>/bin/serve --stdio CODE --link ID",restrict <key> sub-human:CODE:ID
 *       <home>/bin/serve is the stable shim (lib/remote/shim.js): it finds the current plugin install and a
 *       working node at run time, so the line survives plugin updates and node upgrades (absolute paths: sshd's
 *       PATH has no Homebrew). The link id is reserved on the invite now (lib/remote/auth.js reserveLink).
 *       Prints the line; --file appends it to that file (0600) instead, unless the file holds it already, and
 *       refuses when the key is there with another line. --file also rewrites the lines an older authorize wrote
 *       for this home (node and the versioned plugin path baked in) to name the shim. PUBKEY - reads stdin.
 *   Run invite, authorize, host, admit, revoke, prime, link and serve in your own shell: the Bash guard refuses them
 *   to a model.
 */

const path = require('node:path');
const LIB = path.join(__dirname, '..', 'lib');
const identity = require(path.join(LIB, 'identity.js'));
const room = require(path.join(LIB, 'room.js'));
const tasks = require(path.join(LIB, 'tasks.js'));
const config = require(path.join(LIB, 'config.js'));
const cc = require(path.join(LIB, 'cc.js'));
const tailLib = require(path.join(LIB, 'tail.js'));
const statusline = require(path.join(__dirname, '..', 'statusline', 'index.js'));

const NOT_IN_ROOM = 'not in a room; run /sub-human';

function die(msg, code = 2) {
  process.stderr.write(msg + '\n');
  process.exit(code);
}

function parseFlags(args, spec) {
  const flags = {}, rest = [];
  for (let i = 0; i < args.length; i++) {
    const a = args[i];
    if (a === '--') { rest.push(...args.slice(i + 1)); break; }
    if (a.startsWith('--') && a.slice(2) in spec) {
      if (spec[a.slice(2)]) flags[a.slice(2)] = args[++i];
      else flags[a.slice(2)] = true;
      if (flags[a.slice(2)] === undefined) die(`${a} needs a value`);
    } else rest.push(a);
  }
  return { flags, rest };
}

const intList = s => String(s).split(',').filter(Boolean).map(x => {
  const n = Number(x.replace(/^#/, ''));
  if (!Number.isInteger(n) || n <= 0) die(`bad id "${x}"`);
  return n;
});

/** Open the room: an explicit code, else this session's. Returns {code, me|null, r: Room}. */
function openRoom(explicit) {
  if (explicit) {
    if (!identity.roomExists(explicit)) die(`no room "${explicit}"`, 1);
    const me = identity.resolveSelf();
    return { code: explicit, me: me && me.code === explicit ? me : null, r: room.open(explicit) };
  }
  const me = identity.resolveSelf();
  if (!me) die(NOT_IN_ROOM, 1);
  return { code: me.code, me, r: room.open(me.code) };
}

// ---------- tail: lib/tail.js runTail ----------
function tail(args) {
  const { flags } = parseFlags(args, { 'max-seconds': 1, ndjson: 0 }); // --ndjson: the only output, accepted
  let maxSeconds = null;
  if (flags['max-seconds'] != null) {
    maxSeconds = Number(flags['max-seconds']);
    if (!(maxSeconds > 0)) die(`bad --max-seconds "${flags['max-seconds']}"`);
  }
  let handle = null;
  // the reader is gone: nobody to notify
  process.stdout.on('error', () => {
    try { if (handle) handle.stop(); } catch { /* exiting */ }
    process.exit(0);
  });
  // A stray error is logged and the loop carries on (each restart by the mod costs a backoff).
  const lastResort = e => {
    try { process.stderr.write(`sub-human tail: unexpected error: ${e && e.stack || e}\n`); } catch { /* closed */ }
  };
  process.on('uncaughtException', lastResort);
  process.on('unhandledRejection', lastResort);
  // Without a seat, look it up cheaply: the session id the mod sets, no `ps` walk (that runs only when neither
  // variable is set, e.g. a hand-run tail). After /clear the mod starts a new child under the new id.
  const sid = cc.sessionId(), pid = cc.claudePid();
  const lookup = sid || pid
    ? () => (sid && identity.resolveBySession(sid)) || (pid && identity.resolveByPid(pid)) || null
    : () => identity.resolveSelf();
  handle = tailLib.runTail({ write: (text, done) => process.stdout.write(text, done), lookup, maxSeconds, sid });
  // The mod's child: stop cleanly on the way out, and never outlive the session that started it.
  const quit = () => { try { handle.stop(); } catch { /* exiting */ } process.exit(0); };
  for (const sig of ['SIGTERM', 'SIGINT', 'SIGHUP']) process.on(sig, quit);
  const ppid = process.ppid;
  setInterval(() => { if (process.ppid !== ppid) quit(); }, config.TAIL_HEALTH_MS).unref();
}

// ---------- agent-statusline: dispatch to statusline/* ----------
// lib/io.js readInput, never hooks/common.js: requiring that arms the seat-key signer (via=human writes), which
// the CLI and the tail must never load.
const { readInput } = require(path.join(LIB, 'io.js'));

/** statusline agentStatusline(input) -> text ({"id","content"} lines); whatever goes wrong, print nothing and exit 0. */
function agentStatusline() {
  try {
    const out = statusline.agentStatusline(readInput({ strict: false }));
    if (typeof out === 'string' && out) process.stdout.write(out.endsWith('\n') ? out : out + '\n');
  } catch { /* keep the default rendering */ }
}

// ---------- read / digest / who ----------
function read(args) {
  const { flags, rest } = parseFlags(args, { id: 1, json: 0, room: 1 });
  if (!flags.id && rest.length) flags.id = rest.join(','); // `sub-human read 22`, as the cut marker says
  const { me, r } = openRoom(flags.room);
  const show = es => es.forEach(e => console.log(flags.json ? JSON.stringify(e) : room.fmt(e) + '\n'));
  if (flags.id) {
    const es = r.readById(intList(flags.id));
    if (!es.length) die('(no such entries)', 1);
    return show(es);
  }
  if (!me) return show(r.readAll().slice(-50));
  const cursor = `read-${me.name}`;
  const es = r.readAfter(r.getCursor(cursor));
  if (!es.length) return console.log('(no new messages)');
  show(es);
  r.setCursor(cursor, es.at(-1).id);
}

function digest(args) {
  const { flags } = parseFlags(args, { room: 1 });
  const { r } = openRoom(flags.room);
  process.stdout.write(r.digest() + '\n');
}

function who() {
  const me = identity.resolveSelf();
  if (!me) die(NOT_IN_ROOM, 1);
  console.log(`${me.name} (${me.role}) in ${me.code}`);
}

// ---------- tasks ----------
/** lib/tasks.js list(code): the room document `tasks` as the mirror writes it. */
const taskList = code => tasks.list(code) || [];

function tasksCmd(args) {
  const { flags } = parseFlags(args, { json: 0, room: 1 });
  const { code } = openRoom(flags.room);
  let list;
  try { list = taskList(code); } catch (e) { die(`the room task list is unavailable: ${e.message}`, 1); }
  list = list.filter(t => t && !(t.metadata && t.metadata._internal));
  if (flags.json) return console.log(JSON.stringify(list));
  if (!list.length) return console.log(`(no tasks in room ${code})`);
  const w = Math.max(...list.map(t => String(t.status || '').length));
  const o = Math.max(...list.map(t => String(t.owner || '-').length));
  for (const t of list) {
    const blocked = Array.isArray(t.blockedBy) && t.blockedBy.length ? `  (blocked by ${t.blockedBy.map(b => '#' + b).join(',')})` : '';
    const subject = String(t.subject ?? '').replace(/\s+/g, ' ');
    console.log(`#${t.id}  ${String(t.status || '').padEnd(w)}  ${String(t.owner || '-').padEnd(o)}  ${subject}${blocked}`);
  }
}

// ---------- watch NAME ----------
/** Who an entry is from, as a person reading a thread would say it. */
function label(e) {
  if (e.via === 'system') return 'room';
  if (e.from === 'orch') return 'facilitator';
  return e.via === 'agent' ? `${e.from}'s Claude` : e.from;
}

function inThread(name) {
  return e => e.from === name || e.to === name || (e.kind === 'task' && e.owner === name);
}

function watch(args) {
  const { flags, rest } = parseFlags(args, { room: 1, follow: 0, 'no-follow': 0 });
  const name = rest[0];
  if (!name) die('usage: sub-human watch NAME [--room CODE] [--follow|--no-follow]');
  if (!identity.NAME_RE.test(name)) die(`bad name "${name}"`);
  const { code, r } = openRoom(flags.room);
  const color = process.stdout.isTTY && !('NO_COLOR' in process.env);
  const c = (code_, s) => color ? `\x1b[${code_}m${s}\x1b[0m` : s;
  const kindColor = {
    decision: '1;32', signoff: '32', objection: '31', proposal: '1;34', task_req: '36', task: '36',
    member_joined: '2;32', member_left: '2;31',
  };
  const show = inThread(name);
  const print = raw => {
    const e = room.normalize(raw);
    if (!show(e)) return;
    const who = label(e) + (room.unverifiedHuman(e) ? ' (unverified)' : '');
    const whoStr = e.via === 'human' ? c('1', who) : who === 'facilitator' ? c('35', who) : c('2', who);
    const meta = [
      e.to && e.to !== 'room' && `→ ${e.to === name ? name : e.to}`,
      e.refs && e.refs.length && `refs ${e.refs.map(r => '#' + r).join(',')}`,
      (e.hash || e.proposal_hash) && `proposal ${(e.hash || e.proposal_hash).slice(0, 6)}`,
      e.task_id && `task #${e.task_id}`].filter(Boolean).join('  ');
    const head = c('2', `#${e.id} ${String(e.at || '').slice(11, 19)}`);
    console.log(`${head}  ${whoStr}  ${c(kindColor[e.kind] || '2', e.kind)}${meta ? '  ' + c('2', meta) : ''}`);
    console.log(String(e.text ?? '').split('\n').map(l => '    ' + l).join('\n') + '\n');
  };
  const follow = flags.follow ? true : flags['no-follow'] ? false : !!process.stdout.isTTY;
  if (!follow) {
    const es = r.readAll().filter(e => show(room.normalize(e)));
    if (!es.length) return console.log(`(nothing from or to ${name} in room ${code})`);
    return es.forEach(print);
  }
  console.log(c('2', `${name}'s thread in room ${code} (Ctrl-C to stop)`) + '\n');
  process.stdout.on('error', () => process.exit(0));
  r.watch(print, { after: 0, intervalMs: config.WATCH_POLL_MS });
}

// ---------- serve --stdio CODE: lib/remote/server.js ----------
function serve(args) {
  const { flags, rest } = parseFlags(args, { stdio: 0, link: 1 });
  const code = rest[0];
  if (!flags.stdio || !code || rest.length > 1) die('usage: sub-human serve --stdio CODE [--link ID]');
  const { LINK_ID_RE } = require(path.join(LIB, 'remote', 'auth.js'));
  if (flags.link !== undefined && !LINK_ID_RE.test(flags.link)) die(`bad link id "${flags.link}"`);
  if (!identity.roomExists(code)) die(`no room "${code}"`, 1);
  const server = require(path.join(LIB, 'remote', 'server.js'));
  const pipe = require(path.join(LIB, 'remote', 'transports', 'pipe.js'));
  server.serve(pipe.stdio(), { store: room.open(code).store, linkId: flags.link, log: msg => process.stderr.write(msg + '\n') });
}

// ---------- link CODE [--reset], invite: lib/remote/link.js, lib/remote/auth.js ----------
function linkCmd(args) {
  const { flags, rest } = parseFlags(args, { reset: 0 });
  const code = rest[0];
  if (!code) die('usage: sub-human link CODE [--reset]');
  const s = room.open(code).store;
  if (s.isHost) die(`this machine has no link to room "${code}"; join it with /sub-human join NAME INVITE`, 1);
  const link = require(path.join(LIB, 'remote', 'link.js'));
  if (!flags.reset) return link.run({ code }).then(() => process.exit(0), e => die(e.message, 1));
  const st = link.status(code);
  if (st.running) die(`the link daemon of room ${code} is running (pid ${st.pid}); it re-mirrors only once stopped`, 1);
  s.reset();
  if (!link.start(code)) die(`the link daemon of room ${code} did not start`, 1);
  console.log(`room ${code}: copying it again from the host`);
}

function invite(args) {
  const { flags } = parseFlags(args, { room: 1, ssh: 1, via: 1 });
  const { code, r } = openRoom(flags.room);
  if (!r.store.isHost) die(`room ${code} is hosted on another machine; its host gives the invites`, 1);
  const { mintInvite } = require(path.join(LIB, 'remote', 'auth.js'));
  const { pipeLocator, sshLocator } = require(path.join(LIB, 'remote', 'link.js'));
  if (flags.via !== undefined && flags.ssh === undefined) die('--via is for an ssh invite (--ssh USER@HOST)');
  const locator = flags.ssh === undefined ? pipeLocator() : sshLocator(flags.ssh, flags.via !== undefined ? { via: flags.via } : {});
  if (!locator) die(`--ssh needs a plain USER@HOST[:PORT], not "${flags.ssh}"${flags.via !== undefined ? `, and --via a plain [USER@]HOST[:PORT], not "${flags.via}"` : ''}`);
  console.log(mintInvite(r.store, { locator }).invite);
}

// ---------- authorize INVITE|LINK_ID PUBKEY: the SSH forced command for one link ----------
const SSH_KEY_RE = /^(ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp(?:256|384|521)|sk-ssh-ed25519@openssh\.com|sk-ecdsa-sha2-nistp256@openssh\.com) ([A-Za-z0-9+/]+={0,3})(?: .*)?$/;

/** The one public key in text (an authorized_keys or .pub line, options not allowed): "type base64". */
function sshPublicKey(text) {
  const lines = String(text).split('\n').map(l => l.trim()).filter(l => l && !l.startsWith('#'));
  const m = lines.length === 1 && SSH_KEY_RE.exec(lines[0]);
  if (!m) die('PUBKEY must hold exactly one SSH public key line ("ssh-ed25519 AAAA… comment"), with no options');
  return `${m[1]} ${m[2]}`;
}

function authorize(args) {
  const { flags, rest } = parseFlags(args, { room: 1, file: 1 });
  if (rest.length !== 2) die('usage: sub-human authorize INVITE|LINK_ID PUBKEY_FILE|- [--room CODE] [--file AUTHORIZED_KEYS]');
  const fs = require('node:fs');
  const auth = require(path.join(LIB, 'remote', 'auth.js'));
  const { home } = require(path.join(LIB, 'home.js'));
  const inv = auth.parseInvite(rest[0]);
  const code = inv ? inv.code : flags.room;
  if (!code) die('a link id needs --room CODE');
  if (inv && flags.room && flags.room !== inv.code) die(`that invite is to room ${inv.code}, not ${flags.room}`);
  if (!identity.roomExists(code)) die(`no room "${code}"`, 1);
  const s = room.open(code).store;
  if (!s.isHost) die(`room ${code} is hosted on another machine; its host authorizes the links`, 1);
  let id;
  if (inv) id = auth.reserveLink(s, inv.secret);
  else if (auth.linkKnown(s, rest[0])) id = rest[0];
  else die(`"${rest[0]}" is neither an invite nor a link of room ${code}`, 1);
  const key = sshPublicKey(rest[1] === '-' ? fs.readFileSync(0, 'utf8') : fs.readFileSync(rest[1], 'utf8'));
  const shim = require(path.join(LIB, 'remote', 'shim.js'));
  if (!shim.refresh()) die(`the plugin root ${shim.pluginRoot()} is under a temp dir; sshd would run whatever sits there (set SUB_HUMAN_ALLOW_TMP_ROOT=1 to allow)`, 1);
  const h = path.resolve(home());
  if (!shim.PLAIN_PATH_RE.test(h)) die(`the home path "${h}" has characters a forced command cannot carry plainly; move it`);
  const line = shim.authorizedLine(code, id, key, h);
  if (flags.file === undefined) return console.log(line);
  const file = path.resolve(flags.file);
  let cur = '';
  try { cur = fs.readFileSync(file, 'utf8'); } catch (e) { if (e.code !== 'ENOENT') throw e; }
  const mig = shim.migrateLines(cur, h);
  if (mig.migrated) {
    const { writeFileAtomic } = require(path.join(LIB, 'io.js'));
    writeFileAtomic(fs.realpathSync(file), mig.text);
    console.error(`rewrote ${mig.migrated} older sub-human line(s) in ${file} to run ${shim.shimPath(h)}`);
    cur = mig.text;
  }
  const lines = cur.split('\n');
  if (lines.includes(line)) return console.error(`already in ${file}`);
  const blob = key.split(' ')[1];
  if (lines.some(l => l.split(/\s+/).includes(blob))) die(`that key is in ${file} already, with another line; remove it first`, 1);
  fs.mkdirSync(path.dirname(file), { recursive: true, mode: 0o700 });
  fs.appendFileSync(file, (cur && !cur.endsWith('\n') ? '\n' : '') + line + '\n', { mode: 0o600 });
  console.error(`appended to ${file}: link ${id} of room ${code}`);
}

const [cmd, ...args] = process.argv.slice(2);
// Keep the SSH serve shim's pointer on this install and node (lib/remote/shim.js); not on the status line's hot path,
// and never creating a home.
if (cmd !== 'agent-statusline') {
  try { if (require('node:fs').existsSync(identity.home())) require(path.join(LIB, 'remote', 'shim.js')).refresh(); } catch { /* best effort */ }
}
const cmds = { tail, read, digest, who, tasks: tasksCmd, watch, serve, link: linkCmd, invite, authorize, 'agent-statusline': agentStatusline };
// lib/cli/*: each returns the exit code
const viaCli = (file, fn) => a => process.exit(require(path.join(LIB, 'cli', file))[fn](a));
Object.assign(cmds, { host: viaCli('host.js', 'host'), admit: viaCli('host.js', 'admit'), prime: viaCli('host.js', 'prime'), revoke: viaCli('revoke.js', 'revoke') });
try {
  (cmds[cmd] || (() => die('usage: sub-human tail | read [--id N,M] | digest | who | tasks [--json] | watch NAME | serve --stdio CODE [--link ID] | link CODE [--reset] | invite [--ssh USER@HOST[:PORT]] [--via JUMP] | authorize INVITE|LINK_ID PUBKEY [--file F] | host [--ssh [USER@HOST]] [--via JUMP] | admit REQUEST | revoke LINK_ID|NAME | prime CODE | agent-statusline')))(args);
} catch (e) {
  die(e.message, 2);
}
