#!/usr/bin/env node
'use strict';
/**
 * plugin/sub-human/bin/sub-human: the read-only CLI over the room. There is no post command: writes come only
 * from the plugin's hooks and the MCP server. Without --room / CODE, the room is this session's
 * (identity.resolveSelf(): the session id env, then the nearest registered ancestor claude pid).
 *
 *   sub-human tail [ignored args...] [--max-seconds S]
 *       The plugin monitor's command. Silent until resolveSelf() finds this session's registration (checked
 *       every SUB_HUMAN_RESOLVE_MS, default 2000), then follows that room and prints the push lane
 *       (room.lane(me, e) === 'push'; the pull lane is at-room.js's per-prompt digest). It re-resolves on the
 *       same interval and switches (or goes silent) if the session's room or name changes. Resumes from the
 *       cursor tail-<name> and advances it only past entries that were flushed or dropped, so a restart
 *       loses nothing.
 *       Settle: entries are batched and written as ONE block (one notification, one turn) after
 *       SUB_HUMAN_SETTLE_MS (1500) of quiet or SUB_HUMAN_SETTLE_MAX_MS (5000) at most. The block opens with
 *       room.stateLine() ("room now: …", computed at send time), then one room.line(e, {full}) per entry;
 *       each entry is judged again against the log at send time (retracted / signed / decided / superseded
 *       entries are dropped). A member_left X is held SUB_HUMAN_LEAVE_MS (8000): if X rejoins in that time
 *       both notices are dropped, otherwise it goes out marked "· away 8s+".
 *       A member_joined line ends with lib/rows.js joinNote(): whether that member's row is already running in
 *       this session (live holds file), and the Agent call to make only when it isn't. A member is pushed
 *       another member's join only when that note asks for the room-row call.
 *       It also alerts the human (statusline/alert.js, best-effort).
 *   sub-human read [N[,M] | --id N[,M]] [--json] [--room CODE]
 *       entries in full: by id, or this session's unseen entries (cursor read-<name>)
 *   sub-human digest [--room CODE]     the compaction digest (<= 9,500 chars)
 *   sub-human who                      this session's identity: "<name> (<role>) in <code>"
 *   sub-human plan [HASH] [--path] [--room CODE]
 *       the current plan's canonical text (or the plan HASH, a unique prefix of at least 4 hex chars).
 *       --path prints only its file path.
 *   sub-human watch NAME [--room CODE] [--follow|--no-follow]
 *       NAME's thread: their own words, their Claude's posts (labelled "NAME's Claude"), their sign-offs and
 *       objections, their joins/leaves, and entries addressed to them. The orchestrator's posts are labelled
 *       "facilitator". Follows live when stdout is a terminal (or with --follow).
 *   sub-human statusline | agent-statusline
 *       Claude Code's statusLine / subagentStatusLine commands (statusline/*, owner B). Never fail: on any
 *       error they print nothing and exit 0.
 */

const fs = require('node:fs');
const path = require('node:path');
const identity = require(path.join(__dirname, '..', 'lib', 'identity.js'));
const room = require(path.join(__dirname, '..', 'lib', 'room.js'));
const planLib = require(path.join(__dirname, '..', 'lib', 'plan.js'));
const SL = path.join(__dirname, '..', 'statusline');
/** Optional modules (statusline/*, owner B) are loaded lazily so a problem there never breaks tail/read. */
function optional(file) { try { return require(path.join(SL, file)); } catch { return null; } }

const NOT_IN_ROOM = 'not in a room; run /sub-human';

function die(msg, code = 2) {
  process.stderr.write(msg + '\n');
  process.exit(code);
}

function parseFlags(args, spec) {
  const flags = {}, rest = [];
  for (let i = 0; i < args.length; i++) {
    const a = args[i];
    if (a === '--') { rest.push(...args.slice(i + 1)); break; }
    if (a.startsWith('--') && a.slice(2) in spec) {
      if (spec[a.slice(2)]) flags[a.slice(2)] = args[++i];
      else flags[a.slice(2)] = true;
      if (flags[a.slice(2)] === undefined) die(`${a} needs a value`);
    } else rest.push(a);
  }
  return { flags, rest };
}

const intList = s => String(s).split(',').filter(Boolean).map(x => {
  const n = Number(x.replace(/^#/, ''));
  if (!Number.isInteger(n) || n <= 0) die(`bad id "${x}"`);
  return n;
});

/** Bind the room: an explicit code, else this session's. Returns {code, me|null}. */
function bindRoom(explicit) {
  if (explicit) {
    if (!identity.roomExists(explicit)) die(`no room "${explicit}"`, 1);
    room.bind(explicit);
    const me = identity.resolveSelf();
    return { code: explicit, me: me && me.code === explicit ? me : null };
  }
  const me = identity.resolveSelf();
  if (!me) die(NOT_IN_ROOM, 1);
  room.bind(me.code);
  return { code: me.code, me };
}

// ---------- tail ----------
/** The push lane (room.lane), plus, for a member, a member_joined whose row note asks for the room-row call. */
function visibleTo(me) {
  return (e, entries, note = '') => room.lane(me, e, entries) === 'push'
    || (me.role !== 'orch' && e.kind === 'member_joined' && e.from !== me.name && /not running/.test(note));
}
const envMs = (k, d) => (Number(process.env[k]) > 0 ? Number(process.env[k]) : d);

function tail(args) {
  const { flags } = parseFlags(args, { 'max-seconds': 1 });
  const resolveMs = envMs('SUB_HUMAN_RESOLVE_MS', 2000);
  const pollMs = envMs('SUB_HUMAN_POLL_MS', 250);
  const settleMs = envMs('SUB_HUMAN_SETTLE_MS', 1500);       // flush after this long with nothing new
  const settleMaxMs = envMs('SUB_HUMAN_SETTLE_MAX_MS', 5000); // or this long after the batch's first entry
  const leaveMs = envMs('SUB_HUMAN_LEAVE_MS', 8000);         // a member_left waits this long for a rejoin
  process.stdout.on('error', () => process.exit(0));

  let sess = null; // {key, code, stop, save, dead}

  function start(me) {
    room.bind(me.code);
    const reader = `tail-${me.name}`;
    const last = room.lastId();
    let after = room.getCursor(reader);
    if (!(after > 0 && after <= last)) {
      // First watch for this name: start at its join so nothing between join and resolve is lost.
      const joined = room.readAll().filter(e => e.kind === 'member_joined' && e.from === me.name).at(-1);
      after = joined ? joined.id : last;
    }
    room.setCursor(reader, after);
    const s = { key: `${me.code}/${me.name}/${me.role}`, code: me.code, dead: false };
    // The cursor is the highest id h such that every notice for ids <= h has been flushed to stdout.
    // inflight: ids buffered for the next batch, held (member_left), or being written.
    const inflight = new Set();
    let processed = after, saved = after;
    s.save = () => {
      if (s.dead) return;
      const h = inflight.size ? Math.min(...inflight) - 1 : processed;
      if (h > saved) { saved = h; room.bind(s.code); room.setCursor(reader, h); }
    };
    const show = visibleTo(me);
    const rowsMod = require(path.join(__dirname, '..', 'lib', 'rows.js'));
    // member_joined: say whether that member's row already runs here, so the model spawns only a missing one
    const joinNote = e => {
      if (e.kind !== 'member_joined') return '';
      try { return rowsMod.joinNote(me, e.from); } catch { return ''; }
    };
    const alertMod = optional('alert.js');
    const alerter = alertMod && alertMod.createAlerter && alertMod.createAlerter({
      me, dir: room.dir(), pid: me.pid,
      lookup: hash => {
        room.bind(s.code);
        const es = room.readAll();
        return { signedByMe: !!room.signoffMatrix(hash, undefined, es).signed[me.name], decided: !!room.decided(hash, es) };
      },
    });

    // Settle: candidates wait in `pending` and go out as ONE write (one notification, one turn), after
    // settleMs of quiet or settleMaxMs at most. Each is judged again against the log at flush time (lane with
    // entries: retracted, signed, decided, superseded), and every pushed entry is at least settleMs old, so a
    // forged @room line is retracted (at-room's checker) before it could be pushed.
    const pending = []; // {e, at, away}
    const held = new Map(); // name -> {e, timer}: member_left waiting leaveMs for a rejoin
    let quietT = null, maxT = null;
    const arm = () => {
      clearTimeout(quietT);
      quietT = setTimeout(flush, settleMs);
      if (!maxT) maxT = setTimeout(flush, settleMaxMs);
    };
    const enqueue = (e, away = false) => { pending.push({ e, at: Date.now(), away }); arm(); };
    function flush() {
      clearTimeout(quietT); clearTimeout(maxT); quietT = maxT = null;
      if (s.dead) return;
      const now = Date.now();
      const young = pending.filter(p => now - p.at < settleMs - 5);
      const ready = pending.filter(p => !young.includes(p)).sort((x, y) => x.e.id - y.e.id);
      pending.length = 0;
      pending.push(...young);
      if (young.length) arm();
      if (!ready.length) return;
      room.bind(s.code);
      const entries = room.readAll();
      const out = [];
      for (const { e, away } of ready) {
        const note = joinNote(e);
        if (show(e, entries, note)) out.push(room.line(e, { full: true }) + (away ? ` · away ${Math.round(leaveMs / 1000)}s+` : '') + (note ? ` · ${note}` : ''));
      }
      const done = () => { for (const p of ready) inflight.delete(p.e.id); s.save(); };
      if (!out.length) return done();
      process.stdout.write([room.stateLine(me, entries), ...out].join('\n') + '\n', done);
    }

    const stopFollow = room.follow(after, e => {
      if (s.dead) return;
      if (e.id <= processed) { saved = 0; room.setCursor(reader, 0); } // the log was reset under us
      processed = e.id;
      try { if (alerter) alerter.onEntry(e); } catch { /* alerts are best-effort */ }
      if (e.kind === 'member_joined' && held.has(e.from)) {
        // left and back within leaveMs: neither notice is sent
        const h = held.get(e.from);
        clearTimeout(h.timer);
        held.delete(e.from);
        inflight.delete(h.e.id);
        return s.save();
      }
      if (!show(e, undefined, e.kind === 'member_joined' ? 'not running' : '')) return s.save();
      inflight.add(e.id);
      if (e.kind === 'member_left') {
        const prev = held.get(e.from);
        if (prev) { clearTimeout(prev.timer); held.delete(e.from); enqueue(prev.e, true); }
        held.set(e.from, { e, timer: setTimeout(() => { held.delete(e.from); enqueue(e, true); }, leaveMs) });
        return;
      }
      enqueue(e);
    }, { intervalMs: pollMs });
    s.stop = () => {
      stopFollow();
      clearTimeout(quietT); clearTimeout(maxT);
      for (const h of held.values()) clearTimeout(h.timer);
    };
    sess = s;
  }

  function stopSess() {
    if (!sess) return;
    sess.stop();
    sess.save();
    sess.dead = true;
    sess = null;
  }

  function check() {
    let me = null;
    try { me = identity.resolveSelf(); } catch { /* transient ps failure: keep the current state */ return; }
    const key = me ? `${me.code}/${me.name}/${me.role}` : null;
    if (sess && sess.key === key) return;
    stopSess();
    if (me) start(me);
  }

  check();
  const timer = setInterval(check, resolveMs);
  if (flags['max-seconds'] != null) {
    const max = Number(flags['max-seconds']);
    if (!(max > 0)) die(`bad --max-seconds "${flags['max-seconds']}"`);
    setTimeout(() => { clearInterval(timer); stopSess(); }, max * 1000); // node exits once stdout drains
  }
}

// ---------- statusline / agent-statusline: dispatch to statusline/* (owner B) ----------
function readStdinJson() {
  if (process.stdin.isTTY) return {};
  try { return JSON.parse(fs.readFileSync(0, 'utf8') || '{}') || {}; } catch { return {}; }
}

/** Run B's renderer; whatever goes wrong, print nothing and exit 0 (never break Claude Code's bars). */
function dispatchStatus(kind) {
  try {
    const input = readStdinJson();
    const out = renderStatus(kind, input);
    if (typeof out === 'string' && out) process.stdout.write(out.endsWith('\n') ? out : out + '\n');
  } catch { /* keep the default rendering */ }
}
/**
 * B's statusline/index.js ({statusline(input), agentStatusline(input)} -> text) when present; otherwise the
 * segments.js renderer: one line for the main bar, and {"id","content"} lines for room-feed agent rows.
 */
function renderStatus(kind, input) {
  const mod = optional('index.js');
  if (mod) {
    const fn = kind === 'agent' ? mod.agentStatusline : mod.statusline;
    if (typeof fn === 'function') return fn(input);
  }
  const segments = optional('segments.js');
  if (!segments) return '';
  const sid = input && typeof input.session_id === 'string' ? input.session_id : null;
  const me = (sid && identity.resolveBySession(sid)) || identity.resolveSelf();
  if (!me) return '';
  room.bind(me.code);
  const st = segments.state(me, room.readAll());
  if (kind !== 'agent') return segments.render(st, { color: segments.useColor() });
  const isRoomTask = t => !!t && typeof t.id === 'string' && (t.name === 'room' || /^sub-human room\b/i.test(String(t.description || '')));
  const rows = Array.isArray(input.tasks) ? input.tasks.filter(isRoomTask) : [];
  const content = segments.render(st, { color: segments.useColor(), segments: segments.SEGMENTS.filter(x => x.name !== 'seat') });
  return rows.map(t => JSON.stringify({ id: t.id, content })).join('\n');
}
const statusline = () => dispatchStatus('main');
const agentStatusline = () => dispatchStatus('agent');

// ---------- read / digest / who ----------
function read(args) {
  const { flags, rest } = parseFlags(args, { id: 1, json: 0, room: 1 });
  if (!flags.id && rest.length) flags.id = rest.join(','); // `sub-human read 22`, as the cut marker says
  const { me } = bindRoom(flags.room);
  const all = flags.json ? null : room.readAll();
  const show = es => es.forEach(e => console.log(flags.json ? JSON.stringify(e) : room.fmt(e, { entries: all }) + '\n'));
  if (flags.id) {
    const es = room.readById(intList(flags.id));
    if (!es.length) die('(no such entries)', 1);
    return show(es);
  }
  if (!me) return show(room.readAll().slice(-50));
  const cursor = `read-${me.name}`;
  const es = room.readAfter(room.getCursor(cursor));
  if (!es.length) return console.log('(no new messages)');
  show(es);
  room.setCursor(cursor, es.at(-1).id);
}

function digest(args) {
  const { flags } = parseFlags(args, { room: 1 });
  bindRoom(flags.room);
  process.stdout.write(room.digest() + '\n');
}

function who() {
  const me = identity.resolveSelf();
  if (!me) die(NOT_IN_ROOM, 1);
  console.log(`${me.name} (${me.role}) in ${me.code}`);
}

// ---------- plan ----------
function plan(args) {
  const { flags, rest } = parseFlags(args, { room: 1, path: 0 });
  const { code } = bindRoom(flags.room);
  let hash = rest[0];
  if (hash) {
    if (!/^[0-9a-f]{4,12}$/.test(hash)) die(`bad plan hash "${hash}"`);
    let files = [];
    try { files = fs.readdirSync(room.plansDir()).filter(f => /^[0-9a-f]{12}\.md$/.test(f) && f.startsWith(hash)); } catch { /* none */ }
    if (files.length > 1) die(`plan hash "${hash}" is ambiguous: ${files.map(f => f.slice(0, 12)).join(', ')}`, 1);
    if (!files.length) die(`no plan ${hash} in room ${code}`, 1);
    hash = files[0].slice(0, 12);
  } else {
    const cur = room.currentPlan();
    if (!cur) die(`room ${code} has no plan yet`, 1);
    hash = cur.hash;
  }
  if (flags.path) return console.log(planLib.planPath(code, hash));
  const bytes = planLib.canonical(code, hash);
  if (!bytes) die(`the text of plan ${hash} is missing from room ${code}`, 1);
  process.stdout.write(bytes);
  if (bytes.length && bytes[bytes.length - 1] !== 10) process.stdout.write('\n');
}

// ---------- watch NAME ----------
/** Who an entry is from, as a person reading a thread would say it. */
function label(e) {
  if (e.via === 'system') return 'room';
  if (e.from === 'orch') return 'facilitator';
  return e.via === 'agent' ? `${e.from}'s Claude` : e.from;
}

function inThread(name) {
  return e => e.from === name || e.to === name;
}

function watch(args) {
  const { flags, rest } = parseFlags(args, { room: 1, follow: 0, 'no-follow': 0 });
  const name = rest[0];
  if (!name) die('usage: sub-human watch NAME [--room CODE] [--follow|--no-follow]');
  if (!identity.NAME_RE.test(name)) die(`bad name "${name}"`);
  const { code } = bindRoom(flags.room);
  const color = process.stdout.isTTY && !('NO_COLOR' in process.env);
  const c = (code_, s) => color ? `\x1b[${code_}m${s}\x1b[0m` : s;
  const kindColor = { decision: '1;32', signoff: '32', objection: '31', plan_rev: '1;34', member_joined: '2;32', member_left: '2;31' };
  const show = inThread(name);
  const print = raw => {
    const e = room.normalize(raw);
    if (!show(e)) return;
    const who = label(e);
    const whoStr = e.via === 'human' ? c('1', who) : who === 'facilitator' ? c('35', who) : c('2', who);
    const meta = [e.to && e.to !== 'room' && `→ ${e.to === name ? name : e.to}`, e.refs && e.refs.length && `refs ${e.refs.map(r => '#' + r).join(',')}`,
      e.plan_hash && `plan ${e.plan_hash.slice(0, 6)}`].filter(Boolean).join('  ');
    console.log(`${c('2', `#${e.id} ${String(e.at || '').slice(11, 19)}`)}  ${whoStr}  ${c(kindColor[e.kind] || '2', e.kind)}${meta ? '  ' + c('2', meta) : ''}`);
    console.log(String(e.text ?? '').split('\n').map(l => '    ' + l).join('\n') + '\n');
  };
  const follow = flags.follow ? true : flags['no-follow'] ? false : !!process.stdout.isTTY;
  if (!follow) {
    const es = room.readAll().filter(e => show(room.normalize(e)));
    if (!es.length) return console.log(`(nothing from or to ${name} in room ${code})`);
    return es.forEach(print);
  }
  console.log(c('2', `${name}'s thread in room ${code} (Ctrl-C to stop)`) + '\n');
  process.stdout.on('error', () => process.exit(0));
  room.follow(0, print, { intervalMs: 500 });
}

const [cmd, ...args] = process.argv.slice(2);
const cmds = { tail, read, digest, who, plan, watch, statusline, 'agent-statusline': agentStatusline };
try {
  (cmds[cmd] || (() => die('usage: sub-human tail | read [--id N,M] | digest | who | plan [HASH] | watch NAME | statusline | agent-statusline')))(args);
} catch (e) {
  die(e.message, 2);
}
