#!/usr/bin/env node
'use strict';
/**
 * plugin/sub-human/bin/sub-human: the read-only CLI over the room. There is no post command: writes come only
 * from the plugin's hooks and the MCP server. Without --room / CODE, the room is this session's
 * (identity.resolveSelf(): the session id env, then the nearest registered ancestor claude pid).
 *
 *   sub-human tail [ignored args...] [--max-seconds S]
 *       The plugin monitor's command (monitors.json `when: always`, so it runs in every session). Silent until
 *       this session has a seat. While it has none it stays cheap: it looks the seat up only by
 *       CLAUDE_CODE_SESSION_ID / CLAUDE_PID (both set for monitors; no `ps` ancestor walk, which is used only
 *       when neither is set), every SUB_HUMAN_UNSEATED_MS (default 10000). Once seated it re-resolves every
 *       SUB_HUMAN_RESOLVE_MS (2000), follows that room and prints the push lane (room.lane(me, e) === 'push';
 *       the pull lane is at-room.js's per-prompt digest), switching (or going silent) if the seat changes.
 *       Resumes from the cursor tail-<name> and advances it only past entries that were flushed or dropped,
 *       so a restart loses nothing.
 *       Settle: entries are batched and written as ONE block (one notification, one turn) after
 *       SUB_HUMAN_SETTLE_MS (1500) of quiet or SUB_HUMAN_SETTLE_MAX_MS (5000) at most (the orch: 3000 / 10000,
 *       SUB_HUMAN_ORCH_SETTLE_MS / SUB_HUMAN_ORCH_SETTLE_MAX_MS). Each entry is judged again against the log at
 *       send time (retracted / answered / decided entries are dropped). A member_left X is held
 *       SUB_HUMAN_LEAVE_MS (8000): if X rejoins in that time both notices are dropped.
 *       A member's block is a group chat (room.chatLines, no ids): "bob: <exact words>", "bob's Claude: …",
 *       "bob joined", "bob left", which the member's Claude prints as they are and nothing else (member.md).
 *       Lines meant only for Claude start with "(for Claude)": the room state when the batch has a proposal,
 *       answer or decision (room.stateLine, with the card call), a cut message's read call, a missing room
 *       row's Agent call. Claude Code has no surface that puts a persistent line in the transcript without a
 *       model turn (a FileChanged systemMessage is a 5 s footer notification, a monitor event always wakes the
 *       model), so this one wake prints the lines.
 *       Members get every other member's join and settled leave (not the orch's), recorded as shown in
 *       <room>/rows/notices-NAME.json (lib/notices.js; at-room.js shows on the next prompt any the monitor
 *       never sent).
 *       The orch's block opens with room.stateLine() ("room now: …"), then one room.line(e, {full}) per entry
 *       (ids kept: its tools take them), a leave marked "· away 8s+". Its member_joined is pushed when
 *       lib/rows.js joinNote() says that member's row is not running (the line ends with the note and the
 *       Agent call), or when the note is unavailable; a join whose row runs is never pushed.
 *   sub-human read [N[,M] | --id N[,M]] [--json] [--room CODE]
 *       entries in full: by id, or this session's unseen entries (cursor read-<name>)
 *   sub-human digest [--room CODE]     the compaction digest (<= 9,500 chars)
 *   sub-human who                      this session's identity: "<name> (<role>) in <code>"
 *   sub-human tasks [--json] [--room CODE]
 *       the room's shared task list (lib/tasks.js list(code), the orch's native list mirrored to
 *       <room>/tasks.json): "#2 in_progress  bob  parser tests". --json prints the array.
 *   sub-human watch NAME [--room CODE] [--follow|--no-follow]
 *       NAME's thread: their own words, their Claude's posts (labelled "NAME's Claude"), their answers,
 *       their joins/leaves, and entries addressed to them. The orchestrator's posts are labelled
 *       "facilitator". Follows live when stdout is a terminal (or with --follow).
 *   sub-human agent-statusline
 *       Claude Code's subagentStatusLine command (statusline/*). Never fails: on any error it prints
 *       nothing and exits 0.
 */

const fs = require('node:fs');
const path = require('node:path');
const LIB = path.join(__dirname, '..', 'lib');
const identity = require(path.join(LIB, 'identity.js'));
const room = require(path.join(LIB, 'room.js'));
const rows = require(path.join(LIB, 'rows.js'));
const notices = require(path.join(LIB, 'notices.js'));
const tasks = require(path.join(LIB, 'tasks.js'));
const config = require(path.join(LIB, 'config.js'));
const statusline = require(path.join(__dirname, '..', 'statusline', 'index.js'));

const NOT_IN_ROOM = 'not in a room; run /sub-human';

function die(msg, code = 2) {
  process.stderr.write(msg + '\n');
  process.exit(code);
}

function parseFlags(args, spec) {
  const flags = {}, rest = [];
  for (let i = 0; i < args.length; i++) {
    const a = args[i];
    if (a === '--') { rest.push(...args.slice(i + 1)); break; }
    if (a.startsWith('--') && a.slice(2) in spec) {
      if (spec[a.slice(2)]) flags[a.slice(2)] = args[++i];
      else flags[a.slice(2)] = true;
      if (flags[a.slice(2)] === undefined) die(`${a} needs a value`);
    } else rest.push(a);
  }
  return { flags, rest };
}

const intList = s => String(s).split(',').filter(Boolean).map(x => {
  const n = Number(x.replace(/^#/, ''));
  if (!Number.isInteger(n) || n <= 0) die(`bad id "${x}"`);
  return n;
});

/** Bind the room: an explicit code, else this session's. Returns {code, me|null}. */
function bindRoom(explicit) {
  if (explicit) {
    if (!identity.roomExists(explicit)) die(`no room "${explicit}"`, 1);
    room.bind(explicit);
    const me = identity.resolveSelf();
    return { code: explicit, me: me && me.code === explicit ? me : null };
  }
  const me = identity.resolveSelf();
  if (!me) die(NOT_IN_ROOM, 1);
  room.bind(me.code);
  return { code: me.code, me };
}

// ---------- tail ----------
/**
 * The push lane (room.lane). A member also gets every other member's join and leave (a group chat line). The
 * orch gets another member's member_joined when lib/rows.js joinNote() says that row is not running (the note
 * carries the Agent call) or when the note is unavailable; a join whose row already runs is not pushed to it,
 * so a notice never invites a call that row-guard would deny.
 */
const SPAWN_NOTE = /no row running|is not running/;
const isMove = e => e.kind === 'member_joined' || e.kind === 'member_left';
function visibleTo(me) {
  if (me.role !== 'orch') return (e, entries) => room.lane(me, e, entries) === 'push' || (isMove(e) && e.via === 'system' && e.from !== me.name && e.from !== 'orch');
  return (e, entries, note = '') => room.lane(me, e, entries) === 'push'
    || (e.kind === 'member_joined' && e.from !== me.name && (SPAWN_NOTE.test(note) || !note));
}
const STATE_KINDS = new Set(['proposal', 'signoff', 'objection', 'decision']);
const { envMs } = config;

function tail(args) {
  const { flags } = parseFlags(args, { 'max-seconds': 1 });
  const resolveMs = envMs('SUB_HUMAN_RESOLVE_MS', config.RESOLVE_MS);
  const unseatedMs = envMs('SUB_HUMAN_UNSEATED_MS', Math.max(resolveMs, config.UNSEATED_MS)); // no seat: look up this rarely
  const pollMs = envMs('SUB_HUMAN_POLL_MS', config.TAIL_POLL_MS);
  const memberSettleMs = envMs('SUB_HUMAN_SETTLE_MS', config.SETTLE_MS);           // flush after this long with nothing new
  const memberSettleMaxMs = envMs('SUB_HUMAN_SETTLE_MAX_MS', config.SETTLE_MAX_MS); // or this long after the batch's first entry
  // The headless orch waits longer (nobody watches its latency), so a burst of answers, task requests or a
  // join lands as one turn: SUB_HUMAN_ORCH_SETTLE_MS / SUB_HUMAN_ORCH_SETTLE_MAX_MS, unless the member values
  // are set explicitly.
  const orchSettleMs = envMs('SUB_HUMAN_ORCH_SETTLE_MS', process.env.SUB_HUMAN_SETTLE_MS ? memberSettleMs : config.ORCH_SETTLE_MS);
  const orchSettleMaxMs = envMs('SUB_HUMAN_ORCH_SETTLE_MAX_MS', process.env.SUB_HUMAN_SETTLE_MAX_MS ? memberSettleMaxMs : config.ORCH_SETTLE_MAX_MS);
  const leaveMs = envMs('SUB_HUMAN_LEAVE_MS', config.LEAVE_SETTLE_MS); // a member_left waits this long for a rejoin
  process.stdout.on('error', () => process.exit(0));

  let sess = null; // {key, code, stop, save, dead}

  function start(me) {
    room.bind(me.code);
    const reader = `tail-${me.name}`;
    const last = room.lastId();
    let after = room.getCursor(reader);
    if (!(after > 0 && after <= last)) {
      // First watch for this name: start at its join so nothing between join and resolve is lost.
      const joined = room.readAll().filter(e => e.kind === 'member_joined' && e.from === me.name).at(-1);
      after = joined ? joined.id : last;
    }
    room.setCursor(reader, after);
    const s = { key: `${me.code}/${me.name}/${me.role}`, code: me.code, dead: false };
    const settleMs = me.role === 'orch' ? orchSettleMs : memberSettleMs;
    const settleMaxMs = me.role === 'orch' ? orchSettleMaxMs : memberSettleMaxMs;
    // The cursor is the highest id h such that every notice for ids <= h has been flushed to stdout.
    // inflight: ids buffered for the next batch, held (member_left), or being written.
    const inflight = new Set();
    let processed = after, saved = after;
    s.save = () => {
      if (s.dead) return;
      const h = inflight.size ? Math.min(...inflight) - 1 : processed;
      if (h > saved) { saved = h; room.bind(s.code); room.setCursor(reader, h); }
    };
    const show = visibleTo(me);
    // member_joined: say whether that member's row already runs here, so only a missing one is spawned
    const joinNote = e => {
      if (e.kind !== 'member_joined') return '';
      try { return rows.joinNote(me, e.from); } catch { return ''; }
    };

    // Settle: candidates wait in `pending` and go out as ONE write (one notification, one turn), after
    // settleMs of quiet or settleMaxMs at most. Each is judged again against the log at flush time (lane with
    // entries: retracted, signed, decided, superseded), and every pushed entry is at least settleMs old, so a
    // forged @room line is retracted (at-room's checker) before it could be pushed.
    const pending = []; // {e, at, away}
    const held = new Map(); // name -> {e, timer}: member_left waiting leaveMs for a rejoin
    let quietT = null, maxT = null;
    const arm = () => {
      clearTimeout(quietT);
      quietT = setTimeout(flush, settleMs);
      if (!maxT) maxT = setTimeout(flush, settleMaxMs);
    };
    const enqueue = (e, away = false) => { pending.push({ e, at: Date.now(), away }); arm(); };
    function flush() {
      clearTimeout(quietT); clearTimeout(maxT); quietT = maxT = null;
      if (s.dead) return;
      const now = Date.now();
      const young = pending.filter(p => now - p.at < settleMs - 5);
      const ready = pending.filter(p => !young.includes(p)).sort((x, y) => x.e.id - y.e.id);
      pending.length = 0;
      pending.push(...young);
      if (young.length) arm();
      if (!ready.length) return;
      room.bind(s.code);
      const entries = room.readAll();
      const out = [];
      if (me.role === 'orch') {
        for (const { e, away } of ready) {
          const note = joinNote(e);
          if (show(e, entries, note)) out.push(room.line(e, { full: true }) + (away ? ` · away ${Math.round(leaveMs / 1000)}s+` : '') + (note ? ` · ${note}` : ''));
        }
        const done = () => { for (const p of ready) inflight.delete(p.e.id); s.save(); };
        if (!out.length) return done();
        return process.stdout.write([room.stateLine(me, entries), ...out].join('\n') + '\n', done);
      }
      // a member: group-chat lines, then the lines for Claude only
      const seen = notices.shown(s.code, me.name);
      const moved = [], forClaude = [];
      let state = false;
      for (const { e } of ready) {
        if (isMove(e) && seen.has(e.id)) continue; // at-room.js already showed it on a prompt
        if (!show(e, entries)) continue;
        out.push(...room.chatLines(e, { viewer: me.name }));
        if (isMove(e)) moved.push(e.id);
        if (STATE_KINDS.has(e.kind)) state = true;
        const note = e.kind === 'member_joined' ? joinNote(e) : '';
        if (SPAWN_NOTE.test(note)) forClaude.push(`${room.FOR_CLAUDE} ${note}`);
      }
      if (state) forClaude.unshift(`${room.FOR_CLAUDE} ${room.stateLine(me, entries)}`);
      const done = () => { for (const p of ready) inflight.delete(p.e.id); s.save(); };
      if (!out.length) return done();
      if (moved.length) { try { notices.markShown(s.code, me.name, moved, 'monitor'); } catch { /* best effort */ } }
      process.stdout.write([...out, ...forClaude].join('\n') + '\n', done);
    }

    const stopFollow = room.follow(after, e => {
      if (s.dead) return;
      if (e.id <= processed) { saved = 0; room.setCursor(reader, 0); } // the log was reset under us
      processed = e.id;
      if (e.kind === 'member_joined' && held.has(e.from)) {
        // left and back within leaveMs: neither notice is sent
        const h = held.get(e.from);
        clearTimeout(h.timer);
        held.delete(e.from);
        inflight.delete(h.e.id);
        return s.save();
      }
      if (!show(e, undefined, e.kind === 'member_joined' ? 'no row running' : '')) return s.save();
      inflight.add(e.id);
      if (e.kind === 'member_left') {
        const prev = held.get(e.from);
        if (prev) { clearTimeout(prev.timer); held.delete(e.from); enqueue(prev.e, true); }
        held.set(e.from, { e, timer: setTimeout(() => { held.delete(e.from); enqueue(e, true); }, leaveMs) });
        return;
      }
      enqueue(e);
    }, { intervalMs: pollMs });
    s.stop = () => {
      stopFollow();
      clearTimeout(quietT); clearTimeout(maxT);
      for (const h of held.values()) clearTimeout(h.timer);
    };
    sess = s;
  }

  function stopSess() {
    if (!sess) return;
    sess.stop();
    sess.save();
    sess.dead = true;
    sess = null;
  }

  // Without a seat, look it up cheaply: the env Claude Code sets for monitors, no `ps` walk (that runs only
  // when neither variable is set, e.g. a hand-run tail), and only every unseatedMs.
  const hasEnv = !!(process.env.CLAUDE_CODE_SESSION_ID || process.env.CLAUDE_PID);
  const lookup = () => hasEnv
    ? identity.resolveBySession(process.env.CLAUDE_CODE_SESSION_ID) || (identity.claudePid() && identity.resolveByPid(identity.claudePid())) || null
    : identity.resolveSelf();

  let timer = null, stopped = false;
  function check() {
    let me = null;
    try { me = lookup(); } catch { /* transient failure: keep the current state */ return schedule(); }
    const key = me ? `${me.code}/${me.name}/${me.role}` : null;
    if (!(sess && sess.key === key)) {
      stopSess();
      if (me) start(me);
    }
    schedule();
  }
  function schedule() {
    if (stopped) return;
    timer = setTimeout(check, sess ? resolveMs : unseatedMs);
  }

  check();
  if (flags['max-seconds'] != null) {
    const max = Number(flags['max-seconds']);
    if (!(max > 0)) die(`bad --max-seconds "${flags['max-seconds']}"`);
    setTimeout(() => { stopped = true; clearTimeout(timer); stopSess(); }, max * 1000); // node exits once stdout drains
  }
}

// ---------- agent-statusline: dispatch to statusline/* ----------
function readStdinJson() {
  if (process.stdin.isTTY) return {};
  try { return JSON.parse(fs.readFileSync(0, 'utf8') || '{}') || {}; } catch { return {}; }
}

/** statusline agentStatusline(input) -> text ({"id","content"} lines); whatever goes wrong, print nothing and exit 0. */
function agentStatusline() {
  try {
    const out = statusline.agentStatusline(readStdinJson());
    if (typeof out === 'string' && out) process.stdout.write(out.endsWith('\n') ? out : out + '\n');
  } catch { /* keep the default rendering */ }
}

// ---------- read / digest / who ----------
function read(args) {
  const { flags, rest } = parseFlags(args, { id: 1, json: 0, room: 1 });
  if (!flags.id && rest.length) flags.id = rest.join(','); // `sub-human read 22`, as the cut marker says
  const { me } = bindRoom(flags.room);
  const all = flags.json ? null : room.readAll();
  const show = es => es.forEach(e => console.log(flags.json ? JSON.stringify(e) : room.fmt(e, { entries: all }) + '\n'));
  if (flags.id) {
    const es = room.readById(intList(flags.id));
    if (!es.length) die('(no such entries)', 1);
    return show(es);
  }
  if (!me) return show(room.readAll().slice(-50));
  const cursor = `read-${me.name}`;
  const es = room.readAfter(room.getCursor(cursor));
  if (!es.length) return console.log('(no new messages)');
  show(es);
  room.setCursor(cursor, es.at(-1).id);
}

function digest(args) {
  const { flags } = parseFlags(args, { room: 1 });
  bindRoom(flags.room);
  process.stdout.write(room.digest() + '\n');
}

function who() {
  const me = identity.resolveSelf();
  if (!me) die(NOT_IN_ROOM, 1);
  console.log(`${me.name} (${me.role}) in ${me.code}`);
}

// ---------- tasks ----------
/** lib/tasks.js list(code): <room>/tasks.json as the mirror writes it. */
const taskList = code => tasks.list(code) || [];

function tasksCmd(args) {
  const { flags } = parseFlags(args, { json: 0, room: 1 });
  const { code } = bindRoom(flags.room);
  let list;
  try { list = taskList(code); } catch (e) { die(`the room task list is unavailable: ${e.message}`, 1); }
  list = list.filter(t => t && !(t.metadata && t.metadata._internal));
  if (flags.json) return console.log(JSON.stringify(list));
  if (!list.length) return console.log(`(no tasks in room ${code})`);
  const w = Math.max(...list.map(t => String(t.status || '').length));
  const o = Math.max(...list.map(t => String(t.owner || '-').length));
  for (const t of list) {
    const blocked = Array.isArray(t.blockedBy) && t.blockedBy.length ? `  (blocked by ${t.blockedBy.map(b => '#' + b).join(',')})` : '';
    console.log(`#${t.id}  ${String(t.status || '').padEnd(w)}  ${String(t.owner || '-').padEnd(o)}  ${String(t.subject ?? '').replace(/\s+/g, ' ')}${blocked}`);
  }
}

// ---------- watch NAME ----------
/** Who an entry is from, as a person reading a thread would say it. */
function label(e) {
  if (e.via === 'system') return 'room';
  if (e.from === 'orch') return 'facilitator';
  return e.via === 'agent' ? `${e.from}'s Claude` : e.from;
}

function inThread(name) {
  return e => e.from === name || e.to === name || (e.kind === 'task' && e.owner === name);
}

function watch(args) {
  const { flags, rest } = parseFlags(args, { room: 1, follow: 0, 'no-follow': 0 });
  const name = rest[0];
  if (!name) die('usage: sub-human watch NAME [--room CODE] [--follow|--no-follow]');
  if (!identity.NAME_RE.test(name)) die(`bad name "${name}"`);
  const { code } = bindRoom(flags.room);
  const color = process.stdout.isTTY && !('NO_COLOR' in process.env);
  const c = (code_, s) => color ? `\x1b[${code_}m${s}\x1b[0m` : s;
  const kindColor = { decision: '1;32', signoff: '32', objection: '31', proposal: '1;34', task_req: '36', task: '36', member_joined: '2;32', member_left: '2;31' };
  const show = inThread(name);
  const print = raw => {
    const e = room.normalize(raw);
    if (!show(e)) return;
    const who = label(e);
    const whoStr = e.via === 'human' ? c('1', who) : who === 'facilitator' ? c('35', who) : c('2', who);
    const meta = [e.to && e.to !== 'room' && `→ ${e.to === name ? name : e.to}`, e.refs && e.refs.length && `refs ${e.refs.map(r => '#' + r).join(',')}`,
      (e.hash || e.proposal_hash) && `proposal ${(e.hash || e.proposal_hash).slice(0, 6)}`,
      e.task_id && `task #${e.task_id}`].filter(Boolean).join('  ');
    console.log(`${c('2', `#${e.id} ${String(e.at || '').slice(11, 19)}`)}  ${whoStr}  ${c(kindColor[e.kind] || '2', e.kind)}${meta ? '  ' + c('2', meta) : ''}`);
    console.log(String(e.text ?? '').split('\n').map(l => '    ' + l).join('\n') + '\n');
  };
  const follow = flags.follow ? true : flags['no-follow'] ? false : !!process.stdout.isTTY;
  if (!follow) {
    const es = room.readAll().filter(e => show(room.normalize(e)));
    if (!es.length) return console.log(`(nothing from or to ${name} in room ${code})`);
    return es.forEach(print);
  }
  console.log(c('2', `${name}'s thread in room ${code} (Ctrl-C to stop)`) + '\n');
  process.stdout.on('error', () => process.exit(0));
  room.follow(0, print, { intervalMs: config.WATCH_POLL_MS });
}

const [cmd, ...args] = process.argv.slice(2);
const cmds = { tail, read, digest, who, tasks: tasksCmd, watch, 'agent-statusline': agentStatusline };
try {
  (cmds[cmd] || (() => die('usage: sub-human tail | read [--id N,M] | digest | who | tasks [--json] | watch NAME | agent-statusline')))(args);
} catch (e) {
  die(e.message, 2);
}
